#! /bin/bash
#
# bubble_1mom.run_start
#
# Generated by Make Experiments! (mkexp) 1.6.0
#
# $Id: mkexp/defaults/DEFAULT.run.tmpl 29 2026-06-17 11:01:00Z k202123 $
#
# $Id: run/mkexp/defaults/DEFAULT.config 23 2026-02-27 12:50:13Z k202123 $
# icon 2026.04
# $Id: run/mkexp/environments/DEFAULT.config 7 2026-02-27 12:50:34Z k202123 $
# $Id: run/mkexp/environments/levante.config 11 2026-04-01 13:45:44Z m221078 $
# $Id: run/mkexp/types/torus.config 9 2026-02-27 12:52:38Z k202123 $
#

#
# Setup for levante (SLURM)
# $Id: levante.tmpl 2 2025-02-11 k202123 $
#
#SBATCH --job-name=bubble_1mom.run
#SBATCH --account=mh0731
#SBATCH --output=/work/mh0731/m300950/icon-mpim/experiments/bubble_1mom/log/bubble_1mom.run.%8j.log
#SBATCH --partition=compute
#SBATCH --nodes=1
#SBATCH --mem=0
#SBATCH --exclusive
#SBATCH --time=00:05:00


# Environment variables for the target system
# $Id: run/mkexp/environments/resources/environment.sh.tmpl 1 2026-06-08 16:37:02Z m221078 $

export OMP_NUM_THREADS='2'
# OpenMP
export OMP_DYNAMIC='false'
export OMP_SCHEDULE='guided'
export OMP_STACKSIZE='500M'
# Intel OpenMP
export KMP_AFFINITY='granularity=fine,scatter'
export KMP_LIBRARY='turnaround'
# OpenMPI
export OMPI_MCA_btl='self'
export OMPI_MCA_coll='^hcoll,ml'
export OMPI_MCA_coll_tuned_alltoallv_algorithm='2'
export OMPI_MCA_coll_tuned_use_dynamic_rules='true'
export OMPI_MCA_io='^ompio'
export OMPI_MCA_osc='ucx'
export OMPI_MCA_pml='ucx'
export OMPI_MCA_pml_ucx_opal_mem_hooks='1'
# Unified Communication X
export UCX_HANDLE_ERRORS='bt'
export UCX_IB_ADDR_TYPE='ib_global'
export UCX_NET_DEVICES='mlx5_0:1'
export UCX_TLS='mm,cma,dc_mlx5,dc_x,self'
export UCX_UNIFIED_MODE='y'
export UCX_LOG_LEVEL='ERROR' # TODO: unsilence UCX warnings
# HDF5 Library
export HDF5_USE_FILE_LOCKING='FALSE'
export HDF5_PLUGIN_PATH='/sw/spack-levante/netcdf-c-main-bdxvs5/plugins'
# GNU C Library
export MALLOC_TRIM_THRESHOLD_='-1'
# Intel MKL
export MKL_DEBUG_CPU_TYPE='5'
export MKL_ENABLE_INSTRUCTIONS='AVX2'

# Resource limits for the target system
# $Id: run/mkexp/environments/resources/limits.sh.tmpl 1 2026-06-08 16:37:02Z m221078 $

ulimit -c 0
ulimit -s 4194304
#=============================================================================
set -euo pipefail
# Variables initialized from config
ATMO_TIME_STEP='PT30S'
EXP_ID='bubble_1mom'
FINAL_DATE='2008-08-01T02:00:00Z'
INITIAL_DATE='2008-08-01T00:00:00Z'
INTERVAL='P1D'
LOG_DIR='/work/mh0731/m300950/icon-mpim/experiments/bubble_1mom/log'
MODEL_DIR='/home/m/m300950/icon-mpim'
OCEAN_TIME_STEP=''
PREFIX='/work/mh0731/m300950/icon-mpim/build'
SCRIPT_DIR='/home/m/m300950/icon-mpim/experiments/bubble_1mom/scripts'
WORK_DIR='/scratch/m/m300950/icon-mpim/experiments/bubble_1mom/work'


# Utilities
UTILS_DIR=$MODEL_DIR/utils
PATH=$UTILS_DIR:$PATH

# Support log style output
pipe=${EXP_ID}_run_start_$$.pipe
mkfifo $pipe
trap "cd $PWD && rm -f $pipe" EXIT
timewarp $pipe &
exec > $pipe 2>&1

# Convenience link to log file
ln -snvf $LOG_DIR/bubble_1mom.run.$(printf %08d $SLURM_JOBID).log $SCRIPT_DIR/bubble_1mom.run.log

#
# MPI/Scheduler settings
#

# Read and compute time control information

start_date_file=$SCRIPT_DIR/$EXP_ID.date
exp_log_file=$SCRIPT_DIR/$EXP_ID.log

if [[ -f $start_date_file ]]
then
    exec >&2
    echo "Oops: you have tried to begin an experiment that had already been started."
    echo "      Remove '$start_date_file' if you want to continue"
    exit 1
fi
start_date=$INITIAL_DATE

code=$(/work/mh1570/m215048/ci/venv/bin/python3 -c "

# Initialize date/time computation


import sys
import sysconfig
sys.path.append(sysconfig.get_path('platlib', vars={'platbase':'/work/mh0731/m300950/icon-mpim/build'}))
sys.path.extend(['/work/mh0731/m300950/icon-mpim/build/externals/mtime/build/python'])

import mtime
mtime.setCalendar(mtime.CALENDAR_TYPE.year_of_360_days)

# Set up diagnostic output

import logging
import os

logging.basicConfig(format='%(levelname)s%(message)s',
                    level=logging.INFO)
logging.addLevelName(logging.DEBUG, 'Debug: ')
logging.addLevelName(logging.INFO, '')
logging.addLevelName(logging.WARNING, 'Hey: ')
logging.addLevelName(logging.ERROR, 'Oops: ')
logging.addLevelName(logging.CRITICAL, 'Sorry: ')
atmo_time_step = '$ATMO_TIME_STEP'
ocean_time_step = '$OCEAN_TIME_STEP'

class namespace: pass

sh = namespace()

sh.initial_date = mtime.DateTime('$INITIAL_DATE')
sh.final_date = mtime.DateTime('$FINAL_DATE')
sh.start_date = mtime.DateTime('$start_date')
sh.reference_date = sh.initial_date + mtime.TimeDelta('-$INTERVAL')
sh.next_date = sh.start_date + mtime.TimeDelta('$INTERVAL')
if sh.next_date > sh.final_date:
    logging.warning('next date after final date; setting next date to final date')
    sh.next_date_orig = sh.next_date
    sh.next_date = sh.final_date
sh.end_date = sh.next_date + mtime.TimeDelta('-' +
    (atmo_time_step or ocean_time_step or 'PT0.001S'))
sh.atmo_reference_jstep = (
    (sh.initial_date, sh.reference_date)//mtime.TimeDelta(atmo_time_step)
    if atmo_time_step else None
)
sh.ocean_reference_jstep = (
    (sh.initial_date, sh.reference_date)//mtime.TimeDelta(ocean_time_step)
    if ocean_time_step else None
)

for k, v in vars(sh).items():
    print(f'{k}=\'{v}\'')
")
eval "$code"

# Dates used as timestamps
start_stamp=${start_date%.*}
start_stamp=${start_stamp//[-:]/}
end_stamp=${end_date%.*}
end_stamp=${end_stamp//[-:]/}
next_stamp=${next_date%.*}
next_stamp=${next_stamp//[-:]/}
y0=${start_date%%-*}
yN=${end_date%%-*}

# Mark current run as started in log
echo $(date -u +'%Y-%m-%dT%H:%M:%SZ') ${start_date%:*} ${next_date%:*} ${SLURM_JOBID-} start >> $exp_log_file

# Show current start date in job configuration
sh -c 'scontrol update JobId=$SLURM_JOB_ID Comment="$*"' scomment $start_date

# Write namelist files directly to working directory, create this if missing

run_dir=$WORK_DIR/run_${start_stamp}-${end_stamp}

if [[ -d $run_dir ]]
then
    echo "removing run dir '$run_dir'"
    rm -fvr $run_dir
fi

mkdir -vp $run_dir
cd $run_dir

# Namelists

atmo_min_rank=0
atmo_rank_group_size=2
atmo_inc_rank=1
atmo_max_rank=1
atmo_nodes=1

cat > 'icon_master.namelist' << EOF
&master_nml
    lrestart = .false.
    read_restart_namelists = .false.
/
&master_time_control_nml
    calendar = '360 day year'
    checkpointtimeintval = 'P1D'
    restarttimeintval = 'P1D'
    experimentstartdate = '2008-08-01T00:00:00Z' ! TODO: hack to reproduce result
    experimentstopdate = '2008-08-01T02:00:00Z'
/
&master_model_nml ! 'atmo'
    model_name = 'atm'
    model_namelist_filename = 'NAMELIST_atm'
    model_type = 1
    model_min_rank = ${atmo_min_rank}
    model_rank_group_size = ${atmo_rank_group_size}
    model_inc_rank = ${atmo_inc_rank}
    model_max_rank = ${atmo_max_rank}
/

EOF

cat > 'NAMELIST_atm' << EOF

&coupling_mode_nml
    coupled_to_ocean = .false.
/
&parallel_nml
    iorder_sendrecv = 3
    nproma = 32
    num_prefetch_proc = 0
    io_process_stride = 6
    num_io_procs = 0
/
&grid_nml
    dynamics_grid_filename = 'icon_grid_G.nc'
    grid_angular_velocity = 0.
/
&dynamics_nml
    lmoist_thdyn = .true.
    lcoriolis = .false.
/
&run_nml
    num_lev = 70 ! number of full levels
    modeltimestep = 'PT30S'
    ltestcase = .true. ! run testcase
    ldynamics = .true. ! dynamics
    ltransport = .true. ! transport
    iforcing = 2 ! 0: none, 1: HS, 2: ECHAM, 3: NWP
    output = 'nml'
    msg_level = 12 ! level of details report during integration
    restart_filename = 'bubble_1mom_restart_atm_<rsttime>.nc'
    activate_sync_timers = .true.
    profiling_output = 1
/
&nonhydrostatic_nml
    ndyn_substeps = 5 ! dtime/dt_dyn
    damp_height = 22500. ! [m]
    rayleigh_coeff = 0.1000 ! set to 0.1001 for rerun with little change
    vwind_offctr = 0.2
    divdamp_fac = 0.002
/
&interpol_nml
    rbf_scale_mode_ll = 1
    rbf_vec_scale_c = 0.45
    rbf_vec_scale_e = 0.45
    rbf_vec_scale_v = 0.45
/
&sleve_nml
    min_lay_thckn = 20. ! [m]
    top_height = 30000. ! [m]
    stretch_fac = 0.7
    decay_scale_1 = 4000. ! [m]
    decay_scale_2 = 2500. ! [m]
    decay_exp = 1.2
    flat_height = 15000. ! [m]
    htop_thcknlimit = 10000.
    max_lay_thckn = 400.
/
&aes_phy_nml
    ! domain 1
    aes_phy_config(1)%dt_rad = 'PT2M'
    aes_phy_config(1)%dt_vdf = 'PT30S'
    aes_phy_config(1)%dt_mig = 'PT30S'
    aes_phy_config(1)%l2moment = .false.
    aes_phy_config(1)%ljsb = .false.
    aes_phy_config(1)%llake = .false.
    aes_phy_config(1)%iqneg_d2p = 2
    aes_phy_config(1)%iqneg_p2d = 2
    aes_phy_config(1)%zmaxcloudy = 22500.
/
&aes_rad_nml
    ! domain 1
    aes_rad_config(1)%isolrad = 2
    aes_rad_config(1)%irad_h2o = 1
    aes_rad_config(1)%irad_co2 = 2
    aes_rad_config(1)%irad_ch4 = 2
    aes_rad_config(1)%irad_n2o = 2
    aes_rad_config(1)%irad_o3 = 0 ! constant annual cycle climatology
    aes_rad_config(1)%irad_o2 = 0
    aes_rad_config(1)%irad_cfc11 = 0
    aes_rad_config(1)%irad_cfc12 = 0
    aes_rad_config(1)%irad_aero = 0
    aes_rad_config(1)%cecc = 0.0
    aes_rad_config(1)%cobld = 0.0
    aes_rad_config(1)%fsolrad = 0.3185
    aes_rad_config(1)%l_orbvsop87 = .false.
    aes_rad_config(1)%l_sph_symm_irr = .true.
    aes_rad_config(1)%ldiur = .false.
/
! Parameters for all output files
! -------------------------------
&io_nml
    output_nml_dict = 'dict.txt'
    netcdf_dict = 'dict.txt'
    itype_pres_msl = 4
    restart_file_type = 5
    lnetcdf_flt64_output = .true.
/
! Standard AMIP output...
&output_nml ! 'atm_3d'
    output_filename = 'bubble_1mom_atm_3d'
    filename_format = '<output_filename>_<levtype_l>_<datetime2>'
    filetype = 5
    mode = 1
    output_start = '2008-08-01T00:00:00Z'
    output_end = '2008-08-01T02:00:00Z'
    output_interval = 'PT30S'
    file_interval = 'P1DT1S'
    include_last = .false.
    filter_spec = '32001,0,0,0,0,3,2,1'
    ml_varlist = 'ps', 'pfull', 'zg', 'z_ifc', 'rho', 'ta', 'theta_v', 'ua',
                 'va', 'wa', 'hus', 'clw', 'cli', 'qr', 'qs', 'qg', 'cptgz'
    output_grid = .true.
/
! Standard AMIP output...
&output_nml ! 'atm_2d'
    output_filename = 'bubble_1mom_atm_2d'
    filename_format = '<output_filename>_<levtype_l>_<datetime2>'
    filetype = 5
    mode = 1
    output_start = '2008-08-01T00:00:00Z'
    output_end = '2008-08-01T02:00:00Z'
    output_interval = 'PT30S'
    file_interval = 'P1DT1S'
    include_last = .false.
    filter_spec = '32001,0,0,0,0,3,2,1'
    ml_varlist = 'ps', 'psl', 'ts', 'clt', 'prw', 'cllvi', 'clivi', 'qrvi',
                 'qsvi', 'qgvi', 'hfls', 'hfss', 'evspsbl', 'prlr', 'prls',
                 'cptgzvi', 'pr_rain', 'pr_snow', 'pr_grpl', 'pr_ice'
    output_grid = .true.
/
&aes_cov_nml
    aes_cov_config(1)%cqx = 1.e-6
/
&aes_vdf_nml
    aes_vdf_config(1)%pr0 = 0.7
    aes_vdf_config(1)%turb = 2
    aes_vdf_config(1)%use_tmx = .true.
/
&output_nml ! 'atm_cgrid'
    output_filename = 'bubble_1mom_atm_cgrid'
    filename_format = '<output_filename>_<levtype_l>'
    filetype = 5
    mode = 1
    output_start = '2008-08-01T00:00:00Z'
    output_end = '2008-08-01T00:00:00Z'
    output_interval = 'PT30S'
    file_interval = 'P1DT1S'
    filter_spec = '32001,0,0,0,0,3,2,1'
    ml_varlist = 'clon', 'clat', 'areacella', 'zghalf', 'zg'
    output_grid = .true.
/
&transport_nml
    ihadv_tracer = 20, 20, 20, 20, 20
    itype_hlimit = 3, 4, 4, 4, 4, 4
    ivadv_tracer = 3, 3, 3, 3, 3, 3
    tracer_names = 'hus', 'clw', 'cli', 'qr', 'qs', 'qg'
/
&nh_testcase_nml
    nh_test_name = 'aes_bubble'
    ape_sst_case = 'sst_const'
    ape_sst_val = 30.0
/

EOF

# Provide input files

# $Id: format.tmpl 9264 2021-06-21 21:24:57Z m221078 $
#
# [files]

# [files.methods]
function ln_safe { if [[ -e "$1" ]]; then ln -snvf "$1" "$2"; else echo Oops: no \
    such file or directory: "$1" >&2; return 1; fi; }

# [files.buildbot]

# [files.atmosphere]
atmosphere_dir=/pool/data/ICON/grids/public/mpim

# [files.atmosphere.mapped]
mapped_dir=$atmosphere_dir/T001
ln_safe $mapped_dir/icon_grid_T001_Torus_Triangles_20x4_5000m_G.nc \
    icon_grid_G.nc


# [files.atmosphere.model]
model_dir=/home/m/m300950/icon-mpim

# [files.atmosphere.model.run]
run_dir=$model_dir/run
ln_safe $run_dir/dict.iconam.mpim dict.txt

# [files.atmosphere.model.data]
data_dir=$model_dir/data
ln_safe $data_dir/ECHAM6_CldOptProps_rrtmgp_lw.nc \
    rrtmgp-cloud-optics-coeffs-lw.nc
ln_safe $data_dir/ECHAM6_CldOptProps_rrtmgp_sw.nc \
    rrtmgp-cloud-optics-coeffs-sw.nc
ln_safe $data_dir/dmin_wetgrowth_lookup.nc .
ln_safe $data_dir/rrtmgp-gas-lw-g128.nc coefficients_lw.nc
ln_safe $data_dir/rrtmgp-gas-sw-g112.nc coefficients_sw.nc








# Start control jobs in background

echo "starting '$EXP_ID.update'"
$SCRIPT_DIR/$EXP_ID.update $start_date $run_dir &

# Ignition sequence starts...

rm -f finish*.status





# Call processes

srun -l --kill-on-bad-exit=1 --cpu-bind=quiet,cores --distribution=block:block --propagate=STACK,CORE -c 4 -n 2 /work/mh0731/m300950/icon-mpim/build/bin/icon

# Check the model results

for status_file in finish*.status
do
    result=$(cat $status_file 2> /dev/null || echo MISSING)
    result=${result# }

    echo "$status_file: $result"

    if [[ "$result" != "${last_result-$result}" ]]
    then
        echo "Sorry: result from $status_file is inconsistent with the last" >&2
        exit 1
    fi

    last_result=$result
done
finish_status=$last_result

if [[ $finish_status == OK ]]
then
    echo "Experiment finished successfully"
elif [[ $finish_status == RESTART ]]
then
    echo "Experiment to be continued"
else
    echo 'Sorry: model failure, check error messages' >&2
    exit 1
fi
# Handle restart hand-over
if [ -z "${next_date_orig:-}" ] || false
then
    cp -lrfv bubble_1mom_restart_atm_${next_stamp}Z.nc $WORK_DIR
fi

# Clean up our restart
rm -rfv bubble_1mom_restart_atm_${start_stamp}Z.nc

# Mark current run as successful in log
echo $(date -u +'%Y-%m-%dT%H:%M:%SZ') ${start_date%:*} ${next_date%:*} ${SLURM_JOBID-}  end >> $exp_log_file

cd $SCRIPT_DIR
set +e
status=0

exit $status
